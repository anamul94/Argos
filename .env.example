# -----------------------------------------------------------------------------
# Argos Environment Example
# Copy to .env and fill values.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AWS (required for AWS API tools, SNS, CloudWatch, etc.)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token-if-using-temporary-creds
AWS_DEFAULT_REGION=ap-south-1

# -----------------------------------------------------------------------------
# LLM Provider Switch (centralized in utils/llm.py)
# Set to: ollama | bedrock
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Optional global model override for any provider
# LLM_MODEL=glm-4.7-flash:latest

# Optional model temperature (float)
LLM_TEMPERATURE=0

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=glm-4.7-flash:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Bedrock settings (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=bedrock:global.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_OPS_CHAT_ID=your-telegram-ops-chat-id

# -----------------------------------------------------------------------------
# Jira Cloud
# -----------------------------------------------------------------------------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=ops@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task

# -----------------------------------------------------------------------------
# SNS (P1 on-call SMS)
# -----------------------------------------------------------------------------
SNS_ONCALL_PHONE=+15551234567

# -----------------------------------------------------------------------------
# DynamoDB checkpoint + dedup
# -----------------------------------------------------------------------------
# Optional: if empty, graph falls back to in-memory checkpointer
DYNAMODB_CHECKPOINT_TABLE=argos-checkpoints
DYNAMODB_CHECKPOINT_TTL_DAYS=90

# Dedup table and flap cooldown
DYNAMODB_DEDUP_TABLE=argos-dedup
ALARM_FLAP_COOLDOWN_SECONDS=900
